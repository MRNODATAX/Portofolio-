# ============================================================================
# Konfigurasi Opsional Environment Variables (Vercel / Lokal)
# Website & /admin sudah langsung siap jalan di Vercel bahkan tanpa mengisi
# variabel di bawah ini (menggunakan vault kriptografi Ed25519 + scrypt bawaan).
# ============================================================================

# [Opsional] Ganti password Admin Studio (/admin) kapan saja lewat Environment Variable:
ADMIN_PASSWORD=
ADMIN_SECRET=

# [Opsional - Opsi DB #1: Supabase PostgreSQL + Storage]
# Isi kedua variabel di bawah setelah menjalankan supabase/schema.sql di SQL Editor Supabase
# jika ingin editan di /admin, upload gambar, & komentar pengunjung tersimpan permanen di Cloud:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [Opsional - Opsi DB #2: Upstash Redis]
# Alternatif database serverless selain Supabase:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [Opsional - Relay Personal AI Eksternal (OpenAI / Groq / OpenRouter)]
# Jika dikosongkan, Relay otomatis menjawab menggunakan basis pengetahuan portofolio.
CHAT_API_KEY=
CHAT_API_URL=https://api.openai.com/v1/chat/completions
CHAT_MODEL=gpt-4o-mini

# [Opsional] Salt tambahan untuk anti-spam HMAC pada papan kesan pengunjung:
RATING_HASH_SALT=
